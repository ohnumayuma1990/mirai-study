# ==============================================================================
# MiraiStudy Environment Variables Template
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or expose server-only keys under NUXT_PUBLIC_*.
# ==============================================================================

# --- Public (Client-safe Firebase Web Config, exposed via runtimeConfig.public) ---
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Server-only Config & Secrets (Nitro server/** ONLY) ---
# GCP Project ID for Firebase Admin (Auth / Firestore / Cloud Storage)
NUXT_GCP_PROJECT_ID=
# Private Cloud Storage bucket name (recommended region: us-central1 for Always Free)
NUXT_GCS_BUCKET_NAME=
# Optional for local dev only (on Cloud Run, leave empty to use Application Default Credentials)
NUXT_GCP_CLIENT_EMAIL=
NUXT_GCP_PRIVATE_KEY=
# OpenAI API Key (required for Vision ingest; never expose to client)
NUXT_OPENAI_API_KEY=
# Optional OpenAI model override (default: gpt-4.1-mini)
NUXT_OPENAI_MODEL=

# --- Cross-project SSO ---
# Set both flags together. The public flag controls only client navigation and presentation.
NUXT_SSO_ENABLED=
NUXT_PUBLIC_SSO_ENABLED=
# AI ROZA Hub origin (HTTPS in production, no path)
NUXT_SSO_PROVIDER_ORIGIN=
# Shared signing key of at least 32 characters. Inject with Cloud Run --set-secrets.
NUXT_SSO_SHARED_SECRET=

# --- A2A agent (server only; disabled and private by default) ---
NUXT_A2A_ENABLED=
NUXT_A2A_AGENT_CARD_PUBLIC=
NUXT_A2A_ALLOWED_ISSUER=
# Inject through Cloud Run --set-secrets. A nonempty registry replaces the single-caller key.
NUXT_A2A_SHARED_SECRET=
NUXT_A2A_CALLERS_JSON=
